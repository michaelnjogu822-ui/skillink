# Copy this file to .env and replace SECRET_KEY with at least 32 random characters.
# Never commit .env: it holds the key that signs every session cookie.
SECRET_KEY=replace-with-a-long-random-secret

# Database. Leave empty to use SQLite at instance/skilllink.db for local development.
# MySQL example:
# DATABASE_URL=mysql+pymysql://skilllink_user:password@localhost:3306/skilllink?charset=utf8mb4
DATABASE_URL=

# Where profile and portfolio images are stored. Empty means instance/uploads,
# resolved next to the database file so the working directory does not matter.
UPLOAD_FOLDER=

# Set to true only when the site is served over HTTPS. Production refuses to start
# unless this is true.
SESSION_COOKIE_SECURE=false

# Set to "production" on a deployed server to enable ProductionConfig and its
# startup safety checks.
APP_ENV=development

# Brute-force protection for the sign-in form, per email address and client address.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
