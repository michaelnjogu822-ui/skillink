# Copy this file to .env and replace SECRET_KEY with at least 32 random characters.
# Never commit .env: it holds the key that signs every session cookie.
SECRET_KEY=replace-with-a-long-random-secret

# Database. Leave empty to use SQLite at instance/skilllink.db for local development.
# MySQL example:
# DATABASE_URL=mysql+pymysql://skilllink_user:password@localhost:3306/skilllink?charset=utf8mb4
DATABASE_URL=

# Where profile and portfolio images are stored. Empty means instance/uploads,
# resolved next to the database file so the working directory does not matter.
UPLOAD_FOLDER=

# Set to true only when the site is served over HTTPS. Production refuses to start
# unless this is true.
SESSION_COOKIE_SECURE=false

# Set to "production" on a deployed server to enable ProductionConfig and its
# startup safety checks.
APP_ENV=development

# Brute-force protection for the sign-in form, per email address and client address.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300

# Payment provider used by the escrow service. "simulated" settles instantly and
# is the only provider shipped with the project. A real provider registers itself
# in app/services/escrow.py and is selected by name here.
PAYMENT_PROVIDER=simulated

# Transactional email. console = write to the log (development), smtp = real mail,
# memory = capture for tests. The outbox keeps failures for 'flask send-emails'.
MAIL_BACKEND=console
MAIL_DEFAULT_SENDER=SkillLink <no-reply@skilllink.local>
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_TIMEOUT=10

# Production only: how many reverse proxies sit in front of the app.
# Set 1 when nginx or Caddy terminates TLS, so the real client address is used.
TRUSTED_PROXY_COUNT=0
# Production only: public hostname used for links generated outside a request.
SERVER_NAME=

# Application firewall (app/services/firewall.py).
FIREWALL_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_WRITE=60
RATE_LIMIT_AUTH=20
# Comma-separated hostnames the app will answer for. Empty = any host (development).
ALLOWED_HOSTS=
